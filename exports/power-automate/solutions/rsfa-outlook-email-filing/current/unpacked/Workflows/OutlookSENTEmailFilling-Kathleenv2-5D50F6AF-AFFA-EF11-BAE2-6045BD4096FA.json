{
  "properties": {
    "connectionReferences": {
      "shared_office365-1": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "rsfa_sharedoffice365_326a9"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365-2": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "rsfa_sharedoffice365_326a9"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_(V3)": {
          "type": "OpenApiConnectionNotification",
          "inputs": {
            "parameters": {
              "includeAttachments": true,
              "importance": "Any",
              "fetchOnlyWithAttachment": false,
              "folderPath": "Id::AAMkADBlYjcwZjM3LWU2NmQtNDQ5ZC1hMzc4LTZlM2NlODVmYjcyMQAuAAAAAADymMH1UHiJQrhUC9972xXBAQCBq6HJwf27SpXYLDqnt3KEAAAAAAEJAAA="
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "OnNewEmailV3",
              "connectionName": "shared_office365-1"
            }
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "Id::AAMkADBlYjcwZjM3LWU2NmQtNDQ5ZC1hMzc4LTZlM2NlODVmYjcyMQAuAAAAAADymMH1UHiJQrhUC9972xXBAQCBq6HJwf27SpXYLDqnt3KEAAAAAAEJAAA=": "Sent Items"
          }
        }
      },
      "actions": {
        "Initialize_variable_Failed_Item_Address": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FailedAddress",
                "type": "string",
                "value": "tech@rsfa.co.nz;fails_ai_emails-aaaau3vcmr2rjlzgpujc4v6rj4@grid-rsfa-realadvice.org.slack.com"
              }
            ]
          },
          "runAfter": {}
        },
        "Initialize_variable_Comment": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FailedComment",
                "type": "string",
                "value": "Failed Item Email Filling"
              }
            ]
          },
          "runAfter": {
            "Initialize_variable_Failed_Item_Address": [
              "Succeeded"
            ]
          }
        },
        "Initialize_variable_Mail_Connection": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MailConnection",
                "type": "string",
                "value": "insurance@rsfa.co.nz"
              }
            ]
          },
          "runAfter": {
            "Initialize_variable_Comment": [
              "Succeeded"
            ]
          }
        },
        "Catch_Send_Fail_Email": {
          "type": "Scope",
          "actions": {
            "Forward_Failed_Email_to_Tech_Inbox_2": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "message_id": "@triggerOutputs()?['body/id']",
                  "body/ToRecipients": "@variables('FailedAddress')",
                  "body/Comment": "@variables('FailedComment')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "ForwardEmail_V2",
                  "connectionName": "shared_office365-1"
                }
              }
            },
            "Set_Failed_Flag_True_02": {
              "type": "SetVariable",
              "inputs": {
                "name": "FailedFlag",
                "value": true
              },
              "runAfter": {
                "Forward_Failed_Email_to_Tech_Inbox_2": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Processable_Email": [
              "TimedOut",
              "Failed"
            ]
          }
        },
        "Processable_Email": {
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "contains": [
                    "@triggerOutputs()?['body/toRecipients']",
                    "tech@rsfa.co.nz"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Try_Run_Main_Filling_Flow": {
              "type": "Scope",
              "actions": {
                "Run_a_Main_Email_Filling_Flow": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "f6906da4-c8ed-ef11-9341-6045bd3ce9ae"
                    },
                    "body": {
                      "text": "@triggerOutputs()?['body/id']",
                      "text_1": "@variables('MailConnection')"
                    }
                  }
                },
                "Run_a_Child_Flow_Failed": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "startsWith": [
                          "@body('Run_a_Main_Email_Filling_Flow')?['status']",
                          "Failed"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Forward_Failed_Email_to_Tech_Inbox": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "message_id": "@triggerOutputs()?['body/id']",
                          "body/ToRecipients": "@variables('FailedAddress')",
                          "body/Comment": "@variables('FailedComment')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "ForwardEmail_V2",
                          "connectionName": "shared_office365-2"
                        }
                      }
                    },
                    "Set_Failed_Flag_True": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "FailedFlag",
                        "value": true
                      },
                      "runAfter": {
                        "Forward_Failed_Email_to_Tech_Inbox": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Run_a_Main_Email_Filling_Flow": [
                      "Succeeded"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Initialize_Failed_Flag": [
              "Succeeded"
            ]
          }
        },
        "Initialize_Failed_Flag": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FailedFlag",
                "type": "boolean",
                "value": false
              }
            ]
          },
          "runAfter": {
            "Initialize_variable_Mail_Connection": [
              "Succeeded"
            ]
          }
        },
        "Flow_Has_Failed": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@variables('FailedFlag')",
                  "@true"
                ]
              }
            ]
          },
          "actions": {
            "Delay": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 5,
                  "unit": "Second"
                }
              }
            },
            "Get_Failed_Items_Sent_Emails": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "importance": "Any",
                  "fetchOnlyWithAttachment": false,
                  "folderPath": "Id::AAMkADBlYjcwZjM3LWU2NmQtNDQ5ZC1hMzc4LTZlM2NlODVmYjcyMQAuAAAAAADymMH1UHiJQrhUC9972xXBAQCBq6HJwf27SpXYLDqnt3KEAAAAAAEJAAA=",
                  "fetchOnlyUnread": false,
                  "searchQuery": "body:@{variables('FailedComment')}",
                  "top": 10
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "GetEmailsV3",
                  "connectionName": "shared_office365-1"
                }
              },
              "runAfter": {
                "Delay": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "Id::AAMkADAwOGQxMzg1LWI3MTQtNDI2MS1hNzZiLWM0ODRjMDJkZDgwMQAuAAAAAAB-6aZm6gZuS6eGUa5Fpp--AQC8KvZT9kHdTYJ_CW0P9PU3AAAAAAEJAAA=": "Sent Items",
                "Id::AAMkADBlYjcwZjM3LWU2NmQtNDQ5ZC1hMzc4LTZlM2NlODVmYjcyMQAuAAAAAADymMH1UHiJQrhUC9972xXBAQCBq6HJwf27SpXYLDqnt3KEAAAAAAEJAAA=": "Sent Items"
              }
            },
            "Apply_to_each_Failed_Sent_Email": {
              "type": "Foreach",
              "foreach": "@outputs('Get_Failed_Items_Sent_Emails')?['body/value']",
              "actions": {
                "Delete_Failed_Sent_Email": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "messageId": "@items('Apply_to_each_Failed_Sent_Email')?['id']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "DeleteEmail_V2",
                      "connectionName": "shared_office365-1"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Failed_Items_Sent_Emails": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Catch_Send_Fail_Email": [
              "Succeeded",
              "TimedOut",
              "Skipped",
              "Failed"
            ],
            "Processable_Email": [
              "Succeeded",
              "TimedOut",
              "Failed",
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}